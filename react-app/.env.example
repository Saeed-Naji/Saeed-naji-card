# GitHub Pages demo mode needs no values.
# Configure ONLY with the new Saeed corporate Supabase project.
# Do not put service_role, secret keys, passwords or the older project's URL here.
VITE_CORP_SUPABASE_URL=
VITE_CORP_SUPABASE_PUBLISHABLE_KEY=

# Optional public Cloudflare Turnstile site key for the new Saeed quote form.
# Keep empty until the matching server-side TURNSTILE_SECRET_KEY is configured in Saeed Supabase.
VITE_CORP_TURNSTILE_SITE_KEY=
